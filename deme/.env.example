# ── Running as one Node server (npm start, Docker) ──
PORT=8800
# Where the SQLite database file is kept. Put it on a disk that is backed up.
DEME_DB=./data/deme.db

# ── Running on Netlify ──
# A Postgres connection string (use the provider's pooled string). NETLIFY_DB_URL is read too.
DATABASE_URL=

# ── Both ──
# Who may start a new business (a workspace) on this copy.
#   unset  the first visitor starts the first business; after that, nobody else can. Right for a
#          copy that serves one business, such as a dedicated deployment.
#   open   anyone who reaches the site can start a business. Right for the shared platform only
#          once limits are in place.
#   <code> anyone who has this code can start a business. Right for the shared platform while
#          customers are brought on by hand: give each new customer the code.
SIGNUP=
# The site's public address, used for sign-in cookies and the Google return address.
PUBLIC_URL=https://erp.example.com
# Set to 1 when served over HTTPS without PUBLIC_URL or a proxy that sends X-Forwarded-Proto.
DEME_SECURE_COOKIES=0

# Google Workspace sign-in (optional). Create an OAuth client of type "Web application" in Google
# Cloud and add <PUBLIC_URL>/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# On a copy that serves one business: only accounts in this Workspace domain are let in, e.g.
# example.com. Leave empty to admit only people already on the team list. On the shared platform
# each business sets its own domain under Build, and this is left empty.
GOOGLE_WORKSPACE_DOMAIN=

# The platform's own AI connection (optional), used by any business that has not set its own under
# Build: matching spreadsheet columns, reading slips and documents from photos. Uses Claude Haiku.
ANTHROPIC_API_KEY=

# Email notices for tasks, comments and requests to join (optional). Uses Resend (resend.com):
# verify the sending domain there, create an API key, and send from an address on that domain.
RESEND_API_KEY=
MAIL_FROM=Hyper Lychee Labs ERP <erp@example.com>

# Set to off once everyone signs in with Google: email-and-password sign-in is then refused.
PASSWORD_LOGIN=on

# Shopify and Meta below are for a copy that serves one business. On the shared platform each
# business enters its own under Build, and these are left empty.
# Shopify (optional). A custom app in the Shopify admin with read access to orders.
# The store's myshopify.com address and the app's Admin API access token.
SHOPIFY_STORE=
SHOPIFY_TOKEN=
SHOPIFY_API_VERSION=2026-07
# To hear of paid orders at once: add a webhook for "Order payment" to <PUBLIC_URL>/api/shopify/webhook
# and put the webhook signing secret here.
SHOPIFY_WEBHOOK_SECRET=

# Meta ads (optional). The ad account id and a system-user token with ads_read.
META_AD_ACCOUNT=
META_TOKEN=
META_API_VERSION=v23.0
